{
  "name": "sonora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "worker": "tsx src/worker.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "csv-parse": "7.0.3",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.53.0",
    "luxon": "3.7.2",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
