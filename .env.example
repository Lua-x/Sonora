# Generate a private .env with: node scripts/setup-env.mjs
# These placeholders deliberately do not provide usable default secrets.

# 32 random bytes in hexadecimal; URL-safe because Compose embeds it in DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS

# 32 random bytes / exactly 64 hex characters, used for AES-256-GCM source credentials.
# Keep the original key with encrypted backups; changing it invalidates stored credentials.
ENCRYPTION_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS

# Random, at least 32 characters. Required only for creating the first personal account.
SETUP_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SETUP_TOKEN

# Exact public origin, no path. Use https://sonora.example.org behind a reverse proxy.
APP_URL=http://localhost:3000

# Host loopback port; when changed, update APP_URL as well.
PORT=3000

# Default for newly connected automatic sources; configurable in the application.
SYNC_INTERVAL_MINUTES=30

# Optional tested image instead of a local build, e.g. ghcr.io/lua-x/sonora:sha-<commit>.
# SONORA_IMAGE=ghcr.io/lua-x/sonora:sha-<40-character-commit>

# Local development only; Compose assembles DATABASE_URL itself and ignores this value.
# DATABASE_URL=postgresql://sonora:<password>@localhost:5432/sonora
# PGLITE_PATH=./data/development
# LOCAL_WORKER=true
# DEMO_MODE=false
